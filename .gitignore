node_modules/
dist/
build/
coverage/
.vite/

# Working business requirements document — kept locally, never committed.
requirements.md

# Local editor/tooling state — machine-specific, not part of the project.
.claude/

# Env files — .env.example is committed, real .env files never are
.env
.env.local
.env.*.local

# Local file-storage driver target. The directory is kept, its contents are not.
# The ** prefix matters: UPLOAD_DIR is relative to the backend's working directory, so
# uploads land in backend/uploads/, which a root-anchored `uploads/*` would not match.
**/uploads/*
!**/uploads/.gitkeep

*.log
npm-debug.log*
.DS_Store
Thumbs.db
.idea/
*.tsbuildinfo
