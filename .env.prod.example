# Copy to .env beside docker-compose.prod.yml on the server and fill in.
# That file is gitignored and holds real credentials — it must never be committed.

# ── Public address ───────────────────────────────────────────────────────────
# Used as the CORS origin. Must match exactly how the site is reached, scheme
# included, or the browser will refuse the responses.
PUBLIC_ORIGIN=https://clearchain.dmoroz.dev

# ── Database ─────────────────────────────────────────────────────────────────
# Reachable only over the compose network; the port is not published. Generate a
# password rather than inventing one:  openssl rand -base64 24
POSTGRES_USER=clearchain
POSTGRES_PASSWORD=
POSTGRES_DB=clearchain

# ── Authentication ───────────────────────────────────────────────────────────
# Generate both with:
#   npm run auth:hash -w @clearchain/backend -- "<the demo password>"
#
# AUTH_SECRET must NOT be the value from backend/.env.example. That one is published
# in the repository, and anyone holding it can mint a valid session cookie.
AUTH_USER=testUser
AUTH_PASSWORD_HASH=
AUTH_SECRET=

# ── Demo safety ──────────────────────────────────────────────────────────────
# true => every mutating route returns 403. With the sign-in gate in place this can
# stay false, which keeps certificate upload and ERP sync working — the two things
# most worth showing.
DEMO_READONLY=false
