# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Host-run backend (the default `npm run dev` path). docker-compose publishes
# Postgres on 5433, not 5432, to avoid colliding with a locally installed
# PostgreSQL — a very common first-run failure (§15).
DATABASE_URL="postgresql://clearchain:clearchain@localhost:5433/clearchain?schema=public"

# Containerised backend reaches Postgres by compose service name instead.
# Uncomment this form (and comment the one above) when running the backend in Docker.
# DATABASE_URL="postgresql://clearchain:clearchain@db:5432/clearchain?schema=public"

# Separate database for integration tests (§18). Never point this at the dev database.
TEST_DATABASE_URL="postgresql://clearchain:clearchain@localhost:5433/clearchain_test?schema=public"

# ── File storage (§13) ───────────────────────────────────────────────────────
# local | s3 — this is the ONLY switch. NODE_ENV never influences storage (§3).
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# S3 driver only; ignored entirely when STORAGE_DRIVER=local.
# S3_BUCKET=
# S3_REGION=

# ── Authentication ───────────────────────────────────────────────────────────
# One shared demo account. Its credentials are meant to be handed to anyone reviewing
# the project, so this is a gate against crawlers and passers-by rather than a secret.
#
# Regenerate both values with:
#   npm run auth:hash -w @clearchain/backend -- "<your password>"
#
# The values below are for local development. A deployment must replace AUTH_SECRET,
# because this one is published in the repository and anyone holding it can mint a
# valid session cookie.
AUTH_USER=testUser
AUTH_PASSWORD_HASH="scrypt:0ab6ca854f3bf3c06cfee3bdc199017b:13f3aaffc6a3efd22e75797653b146ce3545690036131efe852e3d828d6e4bfab99c5111477e7f6a4e327f4feb632b01fd3154110e47bf1850628bcdde5561af"
AUTH_SECRET="development-only-secret-replace-before-any-deployment"

# ── Demo safety (§14) ────────────────────────────────────────────────────────
# true => every mutating route returns 403 READONLY_MODE.
DEMO_READONLY=false

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
